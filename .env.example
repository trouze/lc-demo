# =============================================================================
# Repository-level variables (shared). Sync with:
#   ./scripts/gh-sync-dbt-cloud-actions-env.sh owner/repo
# =============================================================================

DBT_API_KEY=
DBT_ACCOUNT_ID=
# DBT_URL=https://cloud.getdbt.com
DBT_PROJECTS='{
    "project_1":{"project_id":"123","ci_job_id":"456","cd_job_id":"789"},
    "project_2":{"project_id":"321","ci_job_id":"654","cd_job_id":"987"}
}'

# =============================================================================
# Per GitHub Environment (development, staging, production): same variable NAMES,
# different values in each environment. Create e.g. .env.development and run:
#   ENVIRONMENT=development ENV_FILE=.env.development ./scripts/gh-sync-dbt-cloud-actions-env.sh owner/repo
