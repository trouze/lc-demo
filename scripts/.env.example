# Copy to .env (or e.g. .env.dbt-cloud) and fill in values. Do not commit real secrets.
# Sync to GitHub Actions: ./scripts/gh-sync-dbt-cloud-actions-env.sh <owner/repo>
#
# DBT_API_KEY → repository secret; the rest → repository variables (see dbt-cloud-ci.yml / dbt-cloud-cd.yml).

# dbt Cloud service account / user token (Admin API)
DBT_API_KEY=

# Numeric account id (from dbt Cloud URL or account settings)
DBT_ACCOUNT_ID=

# Optional; omit for multi-tenant cloud.getdbt.com default in workflows
# DBT_URL=https://cloud.getdbt.com
# DBT_URL=https://YOUR_ACCOUNT.us1.dbt.com

# project_1 (path filters in workflows — adjust paths to match your repo)
DBT_PROJECT_ID_1=
DBT_JOB_CI_1=
DBT_JOB_CD_1=

# project_2
DBT_PROJECT_ID_2=
DBT_JOB_CI_2=
DBT_JOB_CD_2=
