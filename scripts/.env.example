# =============================================================================
# Repository-level (.env) — shared across all environments
# Sync with: ENV_FILE=.env ./scripts/gh-sync-dbt-cloud-actions-env.sh owner/repo
# =============================================================================

DBT_API_KEY=
DBT_ACCOUNT_ID=
# DBT_URL=https://cloud.getdbt.com

# =============================================================================
# staging GitHub Environment (.env.staging)
# Trunk dbt Cloud project per folder; staging_merge_job_id is the deploy job ID.
# Sync with: ENVIRONMENT=staging ENV_FILE=.env.staging ./scripts/gh-sync-dbt-cloud-actions-env.sh owner/repo
# =============================================================================
DBT_PROJECTS='{
  "first_dbt_project":  {"project_id": "<trunk project id>",  "staging_merge_job_id": "<staging deploy job id>"},
  "second_dbt_project": {"project_id": "<trunk project id>",  "staging_merge_job_id": "<staging deploy job id>"}
}'

# =============================================================================
# pre-prod GitHub Environment (.env.pre-prod)
# Release dbt Cloud project per folder; environment_id is the pre-prod dbt Cloud environment ID.
# Sync with: ENVIRONMENT=pre-prod ENV_FILE=.env.pre-prod ./scripts/gh-sync-dbt-cloud-actions-env.sh owner/repo
# =============================================================================
# DBT_PROJECTS='{
#   "first_dbt_project":  {"project_id": "<release project id>", "environment_id": "<pre-prod env id>"},
#   "second_dbt_project": {"project_id": "<release project id>", "environment_id": "<pre-prod env id>"}
# }'

# =============================================================================
# prod GitHub Environment (.env.prod)
# Release dbt Cloud project per folder; environment_id is the prod dbt Cloud environment ID.
# Sync with: ENVIRONMENT=prod ENV_FILE=.env.prod ./scripts/gh-sync-dbt-cloud-actions-env.sh owner/repo
# =============================================================================
# DBT_PROJECTS='{
#   "first_dbt_project":  {"project_id": "<release project id>", "environment_id": "<prod env id>"},
#   "second_dbt_project": {"project_id": "<release project id>", "environment_id": "<prod env id>"}
# }'
